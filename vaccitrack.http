@baseUrl = http://localhost:5000/api
@accessToken = <paste_your_access_token_here>
@adminToken = <paste_admin_access_token_here>

### AUTH ROUTES

# Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "mypassword123",
  "role": "user"
}

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "mypassword123"
}

### Refresh Token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "token": "<your_refresh_token>"
}

### Delete Account
DELETE {{baseUrl}}/auth/delete-account
Authorization: Bearer {{accessToken}}


### PROFILE ROUTES

# Create Profile (User)
POST {{baseUrl}}/profiles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "full_name": "John Doe",
  "dob": "2015-06-15",
  "gender": "Male",
  "category": "Child"
}

# Get My Profiles
GET {{baseUrl}}/profiles/my-profiles
Authorization: Bearer {{accessToken}}

# Admin Create Profile
POST {{baseUrl}}/profiles/admin
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "user_id": 1,
  "full_name": "Jane Doe",
  "dob": "1990-02-20",
  "gender": "Female",
  "category": "Adult"
}

# Admin Get All Profiles
GET {{baseUrl}}/profiles/admin/all
Authorization: Bearer {{adminToken}}

# Admin Update Profile
PUT {{baseUrl}}/profiles/admin/2
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "full_name": "Jane Updated"
}

# Admin Delete Profile
DELETE {{baseUrl}}/profiles/admin/2
Authorization: Bearer {{adminToken}}


### VACCINE ROUTES

# Create Vaccine (Admin)
POST {{baseUrl}}/vaccines
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Polio",
  "age_range": "0-5 years",
  "category": "Child",
  "dose_sequence": 1,
  "description": "Protects against polio virus."
}

# Get Vaccines
GET {{baseUrl}}/vaccines
Authorization: Bearer {{accessToken}}


### REMINDER ROUTES

# Create Reminder
POST {{baseUrl}}/reminders/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "vaccineId": 2,
  "dueDate": "2026-03-01",
  "status": "NextDue"
}

# Get Reminders
GET {{baseUrl}}/reminders/1
Authorization: Bearer {{accessToken}}


### DASHBOARD ROUTES

# Get Vaccine Status Dashboard for a Profile
GET {{baseUrl}}/dashboard/1
Authorization: Bearer {{accessToken}}
