{
  "info": {
    "name": "VacciTrack API v1",
    "_postman_id": "12345678-abcd-efgh-ijkl-987654321000",
    "description": "Postman collection for VacciTrack API v1 with Auth, Profiles, Recommendations, Queue Dashboard, and Admin endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"admin@example.com\", \"password\": \"secret\" }",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/v1/auth/login" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.environment.set(\"token\", jsonData.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Profiles - Get Profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/profiles/1" }
      }
    },
    {
      "name": "Recommendations - User",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/recommendations/1?priority=High&dueWithin=7" }
      }
    },
    {
      "name": "Recommendations - Admin Export",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/recommendations/admin/export?format=xlsx" }
      }
    },
    {
      "name": "Queue Dashboard - Stats",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/admin/queue-dashboard" }
      }
    },
    {
      "name": "Queue Dashboard - Trends",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/admin/queue-dashboard/trends" }
      }
    },
    {
      "name": "Queue Dashboard - Monthly",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/admin/queue-dashboard/monthly" }
      }
    },
    {
      "name": "Bull Board UI",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/admin/queues" }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" }
  ]
}


